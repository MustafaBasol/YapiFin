# Uygulama
NEXT_PUBLIC_APP_NAME=YapiFin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL / Prisma
DATABASE_URL=postgresql://yapifin:yapifin_dev_password@localhost:5432/yapifin?schema=public

# Auth.js — production ortamında güçlü ve rastgele değer kullanın
AUTH_SECRET=change-me-with-a-long-random-secret
AUTH_URL=http://localhost:3000

# E-posta daveti (sonraki faz)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=YapiFin <noreply@yapifin.com>

# E-belge/muhasebe entegrasyon kimlik bilgisi şifreleme anahtarı (YF-605-A).
# AUTH_SECRET'ten AYRI olmalıdır — asla yeniden kullanmayın. Boş bırakılırsa
# entegrasyon modülü (opt-in) devre dışı kalır, uygulama başlangıcı ETKİLENMEZ.
# Üretim için: `openssl rand -hex 32` (tam 64 karakterlik onaltılık/hex dize).
INTEGRATION_ENCRYPTION_KEY=

# Dosya depolama (sonraki faz)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis tabanlı dağıtık rate limiting (YF-509) — üretimde zorunludur.
# Boş bırakılırsa (yalnızca development/test) rate limiter süreç-içi
# (per-instance) yedek moda düşer; bkz. lib/rate-limit/policy.ts.
REDIS_URL=redis://localhost:6379
# Üretimde TLS zorunludur (rediss://), yalnızca localhost/127.0.0.1 istisnadır.

# Rate limiter'ın istemci IP'sini X-Forwarded-For'dan güvenle çıkarabilmesi
# için önündeki güvenilir ters proxy/load balancer sayısı. Üretimde açıkça
# ayarlanmalıdır (bkz. lib/rate-limit/client-ip.ts). Doğrudan internete açık,
# proxy'siz bir dağıtımda 0 bırakın.
TRUSTED_PROXY_COUNT=0

# Hata izleme / APM (YF-512) — opsiyoneldir, production dahil hiçbir ortamda
# zorunlu değildir. Boş bırakılırsa monitoring no-op adapter'a düşer (süreç
# ÇÖKMEZ); production'da boşsa bir kerelik uyarı loglanır (bkz.
# lib/monitoring/index.ts, docs/operations/MONITORING_RUNBOOK.md).
SENTRY_DSN=
# Belirtilmezse NODE_ENV kullanılır.
SENTRY_ENVIRONMENT=
# [0,1] aralığında; belirtilmezse 0. Yalnızca production'da dikkate alınır
# (development/test'te her zaman 0 — agresif olmayan varsayılan).
SENTRY_TRACES_SAMPLE_RATE=0
