generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  FINANCE
  PROJECT_MANAGER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/**
 * YF-603 — Hakediş (progress payment) yaşam döngüsü. DRAFT/SUBMITTED
 * serbestçe düzenlenebilir; APPROVED sonrası hakediş kaydının kendisi asla
 * değiştirilmez — ilişkili `FinancialTransaction` üzerinde mevcut
 * `cancelIncome` akışı kullanılır (bkz. ProgressPayment modeli notu).
 */
enum ProgressPaymentStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum SettlementType {
  COLLECTION
  PAYMENT
}

enum SettlementStatus {
  ACTIVE
  CANCELLED
}

enum FinancialAccountType {
  CASH
  BANK
  CREDIT_CARD
  PARTNER_ACCOUNT
  OTHER
}

enum MovementDirection {
  CREDIT
  DEBIT
}

enum MovementType {
  OPENING
  COLLECTION
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  REVERSAL
}

enum TransferStatus {
  ACTIVE
  CANCELLED
}

/**
 * YF-602 — Banka ekstresi içe aktarım satırının durum akışı:
 * IMPORTED (dosyadan normalize edilip kaydedildi, hiçbir finansal etkisi yok)
 * -> CONFIRMING (kullanıcı mutabakatı başlattı, satır kilitlenmiş durumda —
 * eşzamanlı mükerrer onayı engellemek için DocumentExtraction ile aynı
 * kısa süreli kilit bayrağı deseni, bkz. server/services/ledger.ts
 * lockBankImportRow)
 * -> RECONCILED (canonical createSettlement/createTransfer çağrıldı,
 * gerçek bir Settlement veya AccountTransfer oluşturuldu/eşleştirildi)
 * veya IMPORTED -> IGNORED (kullanıcı bu satırı bilinçli olarak dışladı,
 * hiçbir zaman mutabakat sağlanamaz) veya IMPORTED -> ERROR (satır
 * ayrıştırılamadı — tarih/tutar belirsiz/bozuk; asla sessizce 0'a veya
 * geçerli bir tarihe dönüştürülmez, yalnızca incelemek için saklanır, ERROR
 * durumundaki bir satır asla onaylanamaz). CONFIRMING dışında hiçbir durumdan
 * doğrudan finansal kayıt oluşmaz.
 */
enum BankImportRowStatus {
  IMPORTED
  CONFIRMING
  RECONCILED
  IGNORED
  ERROR
}

/**
 * RECONCILED bir satırın hangi canonical kayda bağlandığını belirtir — bkz. server/services/bank-import-service.ts.
 */
enum BankImportReconciliationType {
  COLLECTION
  PAYMENT
  TRANSFER
}

/**
 * YF-601 — OCR/belge çıkarım taslağının durum akışı:
 * PENDING (yükleme kaydedildi, sağlayıcı henüz çağrılmadı)
 * -> EXTRACTED (sağlayıcı adaylarla veya tamamen boş/belirsiz sonuçla döndü)
 * -> CONFIRMING (kullanıcı onayı başladı, satır kilitlenmiş durumda —
 * eşzamanlı mükerrer onayı engellemek için kısa süreli bir kilit bayrağı)
 * -> CONFIRMED (canonical createExpense çağrıldı, gerçek gider oluşturuldu)
 * veya PENDING -> FAILED (sağlayıcı hata fırlattı, adaylar üretilemedi).
 * DRAFT dışında hiçbir durumdan doğrudan finansal kayıt oluşmaz — yalnızca
 * CONFIRMED, insan onaylı bir server action üzerinden ulaşılabilir bir uçtur.
 */
enum DocumentExtractionStatus {
  PENDING
  EXTRACTED
  FAILED
  CONFIRMING
  CONFIRMED
}

/**
 * YF-605-A — Sağlayıcı-nötr entegrasyon temeli (bkz.
 * docs/architecture/YF-605_EINVOICE_ACCOUNTING_INTEGRATIONS.md §4/§7).
 * Bu fazda gerçek bir sağlayıcı adaptörü YOKTUR; bu enum yalnızca hangi
 * sağlayıcının hedeflendiğini kaydeden, kod tarafında hiçbir ağ çağrısına
 * bağlı olmayan bir sınıflandırma değeridir. `GENERIC`, henüz sağlayıcı
 * seçilmemiş/test amaçlı no-op bağlantılar içindir.
 */
enum IntegrationType {
  E_INVOICE
  ACCOUNTING
}

enum IntegrationProvider {
  NILVERA
  UYUMSOFT
  IZIBIZ
  SOVOS
  QNB_ESOLUTIONS
  PARASUT
  GENERIC
}

enum IntegrationEnvironment {
  SANDBOX
  PRODUCTION
}

/**
 * Varsayılan INACTIVE'dir (bkz. mimari doküman §15 — modül organizasyon bazında opt-in). SUSPENDED bu fazda hiçbir yerden yazılmaz; gelecekteki sağlayıcı-tetiklemeli akışlar için şema düzeyinde ayrılmıştır.
 */
enum IntegrationConnectionStatus {
  INACTIVE
  ACTIVE
  SUSPENDED
}

enum IntegrationEventDirection {
  INBOUND
  OUTBOUND
}

enum IntegrationEventStatus {
  SUCCESS
  FAILURE
}

/**
 * Organizasyon başına sağlayıcı bağlantı yapılandırması. `DocumentExtraction`
 * ile aynı ilke izlenir: `organizationId` Prisma `@relation` FK'i OLMADAN düz
 * sütun + index olarak tutulur (Organization/User modeline dokunulmaz, blast
 * radius minimize edilir) — tenant izolasyonu servis katmanında
 * `id + organizationId` ile sağlanır.
 */
model IntegrationConnection {
  id               String                      @id @default(cuid())
  organizationId   String
  integrationType  IntegrationType
  provider         IntegrationProvider
  environment      IntegrationEnvironment
  displayName      String
  status           IntegrationConnectionStatus @default(INACTIVE)
  externalTenantId String?
  createdById      String
  updatedById      String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@unique([organizationId, integrationType, provider, environment])
  @@index([organizationId, status])
}

/**
 * Şifreli kimlik bilgisi referansı — bağlantı başına en fazla bir satır
 * (1:1). Düz metin sır ALANI YOKTUR; yalnızca AES-256-GCM şifreli materyal
 * ve çözme için gereken meta veriler (iv, authTag, keyVersion) saklanır (bkz.
 * lib/integration-crypto.ts, docs/architecture/YF-605_...md §8).
 */
model IntegrationCredential {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String   @unique
  ciphertext     String
  iv             String
  authTag        String
  keyVersion     Int      @default(1)
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, connectionId])
}

/**
 * Bağlantı yaşam döngüsü/dış çağrı denetim izi (bkz. mimari doküman §7/§11).
 * Bu fazda dış sağlayıcı çağrısı YAPILMADIĞI için tüm kayıtlar yönetici
 * tetiklemeli bağlantı/kimlik bilgisi olaylarıdır (`direction: null`,
 * `status: SUCCESS`); sonraki fazlar aynı tabloyu gerçek sağlayıcı
 * çağrıları/webhook olayları için de kullanacaktır. `errorSummary` asla ham
 * sır/tam payload içermez — yalnızca insan-okunur, güvenli bir özet.
 */
model IntegrationEventLog {
  id             String                     @id @default(cuid())
  organizationId String
  connectionId   String
  actorId        String?
  eventType      String
  direction      IntegrationEventDirection?
  status         IntegrationEventStatus     @default(SUCCESS)
  errorCode      String?
  errorSummary   String?
  createdAt      DateTime                   @default(now())

  @@index([organizationId, connectionId, createdAt])
  @@index([organizationId, eventType])
}

/**
 * YF-802 — Plan/paket tanımı: kota (nicel limit) ve modül erişimi (ikili
 * yetenek) verisinin TEK kaynağı. Kod içinde HİÇBİR YERDE `if (plan ===
 * 'pro')` gibi sabit kodlanmış karşılaştırma YAPILMAZ (bkz. görev talimatı
 * "Does NOT hardcode pricing anywhere in domain services") — tüm iş
 * servisleri yalnızca `lib/entitlements/entitlement-service.ts` üzerinden
 * sorgular. `capabilities`/`limits` kararlı, makine-okunur anahtarlarla
 * (bkz. lib/entitlements/capabilities.ts CAPABILITY_IDS/LIMIT_IDS) anahtarlı
 * bir JSON haritasıdır — yeni bir yetenek/limit eklemek yalnızca bu tabloya
 * bir satır/anahtar eklemek demektir, şema veya çağrı noktası değişikliği
 * GEREKTİRMEZ. Bir limit anahtarının değeri `null` ise sınırsız demektir;
 * bir capability anahtarı haritada YOKSA veya `false` ise erişim reddedilir
 * (fail-closed — bkz. entitlement-service.ts canUseCapability).
 * Güvenlik tabanı (kimlik doğrulama, tenant izolasyonu, audit log, finansal
 * Decimal doğruluğu) bu modelin/JSON'un HİÇBİR alanı üzerinden
 * kapatılamaz/etkilenemez — entitlement sistemi yalnızca ticari
 * modül/kota sınırlamaları içindir (bkz. görev talimatı "Security
 * baseline ... must never be gateable by plan").
 */
model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  /**
   * ör. { "users.active": 3, "projects.active": 3 } — anahtar yoksa/null ise sınırsız.
   */
  limits       Json     @default("{}")
  /**
   * ör. { "ocr": true, "bank_import": true, "reports.advanced": false } — anahtar yoksa fail-closed reddedilir.
   */
  capabilities Json     @default("{}")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizations Organization[]
}

/**
 * YF-808 — Stripe ortamı. Bir dağıtımın yalnızca TEK bir Stripe ortamı
 * olabilir (gizli anahtarın önekinden türetilir, bkz.
 * lib/billing/stripe-config.ts). Bu enum kalıcı eşlemelerin hangi ortamda
 * oluştuğunu kaydeder — TEST ortamında oluşmuş bir müşteri LIVE ortamında
 * ASLA yeniden kullanılamaz.
 */
enum StripeEnvironment {
  TEST
  LIVE
}

/**
 * YF-808 — Organizasyon ↔ Stripe Customer eşlemesi. Ödeme sağlayıcısı
 * kimliğinin TEK kanonik kaynağıdır.
 * **Yetki ile ilgisi yoktur.** Bu tablodaki hiçbir satır/alan bir yetenek,
 * kota veya erişim HAKKI vermez; uygulama erişimi her zaman ve yalnızca
 * `Organization.planId` → `Plan` (YF-802,
 * lib/entitlements/entitlement-service.ts) üzerinden çözülür. Bu yüzden burada
 * bilinçli olarak plan/price/ürün alanı TUTULMAZ — Stripe tarafındaki bir
 * Product/Price/metadata değişikliğinin entitlement sonucunu etkilemesi
 * yapısal olarak imkânsızdır.
 * `IntegrationConnection` ile aynı ilke izlenir: `organizationId` Prisma
 * `@relation` FK'i OLMADAN düz sütun + index olarak tutulur (Organization
 * modeline dokunulmaz, blast radius minimize edilir) — tenant izolasyonu
 * servis katmanında `organizationId + environment` ile sağlanır.
 * Eşzamanlılık/tekrar güvenliği: `@@unique([organizationId, environment])`
 * "bu organizasyonun bu ortamda müşterisi var mı" sorusunun TEK doğruluk
 * kaynağıdır (check-then-insert yarışı yoktur — P2002 yakalanıp mevcut satır
 * yeniden okunur). `@@unique([environment, stripeCustomerId])` ise aynı Stripe
 * müşterisinin iki farklı organizasyona bağlanmasını (tenant sızıntısı)
 * veritabanı düzeyinde imkânsız kılar.
 * Yalnızca sunucu tarafı servis katmanı yazar (bkz.
 * server/services/billing/stripe-customer-service.ts); istemciden gelen bir
 * Stripe Customer/Price/Product kimliği ASLA yazılmaz veya güvenilmez.
 */
model OrganizationStripeCustomer {
  id               String            @id @default(cuid())
  organizationId   String
  environment      StripeEnvironment
  stripeCustomerId String
  /**
   * Müşteriyi oluştururken kullanılan deterministik Stripe idempotency anahtarı — denetim/teşhis içindir, sır DEĞİLDİR.
   */
  idempotencyKey   String
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, environment])
  @@unique([environment, stripeCustomerId])
  @@index([organizationId])
}

/** YF-809 — Stripe Checkout'ta seçilebilen faturalama aralığı. */
enum BillingInterval {
  MONTHLY
  ANNUAL
}

/**
 * YF-809 hotfix — bir `OrganizationCheckoutAttempt` satırının yaşam döngüsü.
 * `RESERVED`: Stripe'a gidilmeden ÖNCE org-kilidi altında atomik olarak
 * ayrılmış, henüz Stripe Checkout Session'ı YOK; `reservationExpiresAt`
 * içinde tamamlanmazsa bayat sayılır (bkz. `CHECKOUT_RESERVATION_TTL_MS`).
 * `COMPLETED`: Stripe Checkout Session başarıyla oluşturuldu.
 */
enum CheckoutAttemptStatus {
  RESERVED
  COMPLETED
}

/**
 * YF-809 — Bir organizasyonun EN SON/AÇIK kendi-kendine Stripe Checkout
 * denemesini tutar. **Bu bir abonelik/lifecycle kaydı DEĞİLDİR** — YF-810
 * webhook senkronizasyonu abonelik doğruluğunun tek kaynağı olacaktır (bkz.
 * docs/architecture/YF-809_STRIPE_CHECKOUT.md §7). Bu tablonun TEK amacı,
 * aynı organizasyonun kısa süre içinde birden fazla kendi-kendine ödeme
 * denemesi başlatmasını engellemek için minimal, dayanıklı bir durumdur.
 *
 * `organizationId` BİLİNÇLİ OLARAK birincil anahtardır (cuid `id` yerine):
 * bir organizasyonun aynı anda yalnızca TEK açık denemesi olabileceği
 * PostgreSQL tarafından yapısal olarak garanti edilir — filtrelenmiş
 * (partial) bir unique index İCAT EDİLMEZ.
 *
 * **Eşzamanlılık (YF-809 hotfix):** satır, Stripe'a gidilmeden ÖNCE
 * `RESERVED` durumunda, organizasyon satırının `SELECT ... FOR UPDATE`
 * kilidi ALTINDA yazılır (bkz. server/services/billing/checkout-service.ts
 * `reserveCheckoutAttempt`, `lib/entitlements/entitlement-service.ts`
 * `lockOrganizationForEntitlement` ile AYNI desen). Bu kilit, aynı
 * organizasyon için TÜM eşzamanlı rezervasyon denemelerini serileştirdiği
 * için check-then-insert yarışı yapısal olarak YOKTUR (P2002 yakalamaya
 * gerek kalmaz). `attemptCount`, `AiUsageLedger` ile AYNI "fencing" (çitleme)
 * deseninde kullanılır: Stripe yanıtı döndükten SONRAKİ commit/release
 * yalnızca rezervasyonu HÂLÂ kendisinin sahip olduğunu (attemptCount eşleşir)
 * doğrularsa yazar; aksi halde sessizce atlanır (satır başka bir deneme
 * tarafından zaten geri kazanılmıştır).
 */
model OrganizationCheckoutAttempt {
  organizationId          String                @id
  environment             StripeEnvironment
  planCode                String
  billingInterval         BillingInterval
  status                  CheckoutAttemptStatus @default(RESERVED)
  /** Yalnızca `status = COMPLETED` iken doludur. */
  stripeCheckoutSessionId String?               @unique
  stripeCustomerId        String
  /** Deterministik idempotency anahtarı — bkz. buildCheckoutIdempotencyKey. */
  idempotencyKey          String                @unique
  createdById             String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  /** Rezervasyon/commit "fencing" sayacı — bkz. yukarıdaki eşzamanlılık notu. */
  attemptCount            Int                   @default(1)
  /** `RESERVED` rezervasyonun bu andan sonra bayat sayılacağı, kurtarılabilir bounded TTL (bkz. `CHECKOUT_RESERVATION_TTL_MS`). */
  reservationExpiresAt    DateTime
  /** Stripe Checkout Session'ın süre dolma zamanı (Stripe varsayılanı: oluşturmadan ~24 saat sonra); yalnızca `status = COMPLETED` iken doludur. Bu andan sonra satır BAYAT sayılır ve yeni bir deneme onun yerini alabilir. */
  expiresAt               DateTime?

  @@index([expiresAt])
}

/**
 * YF-810 — Stripe `Subscription.status`'un yerel yansımasıdır (bkz. Stripe
 * API "2026-07-29.dahlia" `Subscription.Status`: 'active' | 'canceled' |
 * 'incomplete' | 'incomplete_expired' | 'past_due' | 'paused' | 'trialing' |
 * 'unpaid' | gelecekteki bilinmeyen değerler). `UNKNOWN`, Stripe'ın ileride
 * ekleyebileceği ve bu kod tabanının henüz TANIMADIĞI bir durum dizesi için
 * fail-closed bir yedektir (bkz. server/services/billing/webhook-service.ts
 * `toSubscriptionStatus`) — asla bir Prisma yazma hatasıyla ÇÖKMEZ, yalnızca
 * entitlement kazandırmaz.
 */
enum StripeSubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
  UNKNOWN
}

/** YF-810 — en son işlenen fatura ödeme denemesinin sonucu (bkz. `invoice.payment_succeeded`/`invoice.payment_failed`). */
enum StripeInvoicePaymentStatus {
  SUCCEEDED
  FAILED
}

/**
 * YF-810 — bir Stripe webhook olayının idempotent işlenmişlik kaydı. Stripe
 * AYNI olayı birden fazla kez teslim edebilir (en-az-bir-kez teslim garantisi
 * + otomatik yeniden deneme) — `stripeEventId` üzerindeki veritabanı düzeyi
 * `@unique` kısıtı, ikinci bir teslimatın ASLA ikinci bir yan etki
 * ÜRETMEMESİNİ garanti eder (bkz. webhook-service.ts `claimEvent` — `create`
 * + P2002 yakalama, `AiUsageLedger`/`OrganizationStripeCustomer` ile AYNI
 * "önce veritabanı düzeyinde tekillik, sonra uygulama mantığı" felsefesi).
 *
 * Ham Stripe olay gövdesi/payload'ı BURADA DA ASLA SAKLANMAZ (görev talimatı
 * "never log secrets or the raw full payload") — yalnızca korelasyon,
 * mutabakat ve gözlemlenebilirlik için gereken minimal, sır İÇERMEYEN
 * alanlar tutulur.
 */
model StripeWebhookEvent {
  id             String                    @id @default(cuid())
  stripeEventId  String                    @unique
  environment    StripeEnvironment
  eventType      String
  /**
   * Olayın ait olduğu organizasyon. Yalnızca Stripe müşterisi
   * `OrganizationStripeCustomer` eşlemesi üzerinden BAŞARIYLA çözülebildiyse
   * doludur (bkz. dosya başı OrganizationStripeCustomer notu — kanonik
   * eşleme kaynağı budur, webhook metadata'sı ASLA doğrudan güvenilmez).
   * Çözülemezse `null` — bu durumda hiçbir organizasyona yazma YAPILMAZ
   * (fail-closed, bkz. webhook-service.ts).
   */
  organizationId       String?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               StripeWebhookEventStatus @default(RECEIVED)
  /** Sabit, güvenli, sır İÇERMEYEN kısa hata özeti — ham istisna gövdesi/mesajı ASLA yazılmaz (bkz. lib/billing/errors.ts redactBillingSecrets ile AYNI disiplin). */
  errorSummary         String?
  /** İşleme denemesi sayısı — yeniden teslimat/yeniden deneme gözlemlenebilirliği içindir. */
  attempts             Int                       @default(0)
  /** Stripe'ın olayı oluşturduğu an (`event.created`, Unix saniye → DateTime) — sıra-dışı (out-of-order) teslimat gözlemlenebilirliği için (bkz. OrganizationStripeSubscription.lastProcessedEventCreatedAt). */
  stripeCreatedAt      DateTime
  receivedAt           DateTime                  @default(now())
  processedAt          DateTime?

  @@index([organizationId, stripeCreatedAt])
  @@index([status])
  @@index([stripeSubscriptionId])
}

enum StripeWebhookEventStatus {
  /** Olay veritabanı düzeyinde "iddia edilmiş" (claimed) — işleme ya devam ediyor ya da bir önceki deneme çökmüş (yeniden teslimatta güvenle yeniden denenir). */
  RECEIVED
  PROCESSED
  /** İşleme başarısız oldu — Stripe'ın yeniden teslimatında güvenle YENİDEN DENENİR (bkz. webhook-service.ts `claimEvent`). */
  FAILED
  /** Geçerli bir olaydı ama bu kod tabanının ele aldığı bir tür/organizasyon eşlemesi DEĞİLDİ — bilinçli olarak atlandı (yeniden işlenmez, ama yeniden denemeyi de TETİKLEMEZ). */
  IGNORED
}

/**
 * YF-810 — Bir organizasyonun GÜNCEL kendi-kendine Stripe abonelik durumu.
 * `OrganizationCheckoutAttempt` (YF-809) ile AYNI desen: `organizationId`
 * BİLİNÇLİ OLARAK birincil anahtardır — bu üründe organizasyon başına
 * (kendi-kendine akışta) tek bir GÜNCEL abonelik yeterlidir. Bir organizasyon
 * iptal SONRASI yeniden abone olursa (Stripe'ta YENİ bir Subscription nesnesi
 * oluşur), bu satır o YENİ `stripeSubscriptionId`'yi ÜZERİNE YAZAR — ayrı bir
 * geçmiş kaydı TUTULMAZ (görev kapsamı bunu gerektirmiyor; ham olay geçmişi
 * zaten `StripeWebhookEvent`'te ve Stripe panelinde erişilebilirdir).
 *
 * **Yetki ile İLGİSİ YOKTUR** — `OrganizationStripeCustomer` ile AYNI ilke
 * (bkz. o modelin başlık yorumu). Uygulama erişimi HER ZAMAN
 * `Organization.planId` → `Plan` üzerinden, `lib/entitlements/entitlement-service.ts`
 * ile çözülür; bu satır YALNIZCA hangi planın webhook senkronizasyonu
 * tarafından EN SON grantlandığını (`lastGrantedPlanId`) ve Stripe'ın ham
 * abonelik anlık görüntüsünü izler — bir yetki KARARI ÜRETMEZ, yalnızca
 * `Organization.planId` mutasyonunun GİRDİSİDİR.
 *
 * **Sıra-dışı (out-of-order) olay koruması:** bu satır YALNIZCA Stripe'tan
 * YENİDEN ÇEKİLEN (retrieve) güncel `Subscription` anlık görüntüsüyle yazılır
 * (bkz. `lib/billing/stripe-gateway.ts` `retrieveSubscription` dosya başı
 * notu ve `server/services/billing/webhook-service.ts`
 * `syncSubscriptionFromStripe`) — hangi OLAY tetiklediği ÖNEMLİ DEĞİLDİR, her
 * zaman Stripe'ın O ANKİ gerçeğini yansıtır; bu nedenle geç/sıra-dışı teslim
 * edilen bir olay dahi yerel durumu ESKİ bir anlık görüntüyle asla EZEMEZ.
 * `lastProcessedEventId`/`lastProcessedEventCreatedAt` YALNIZCA
 * gözlemlenebilirlik/teşhis amaçlıdır (monoton olarak İLERİ taşınır) —
 * yazma kararını ETKİLEMEZ.
 */
model OrganizationStripeSubscription {
  organizationId       String                    @id
  environment          StripeEnvironment
  stripeCustomerId     String
  stripeSubscriptionId String
  /** İlk (ve kendi-kendine akışımızda TEK) abonelik kaleminin Price ID'si. */
  stripePriceId        String
  /**
   * `lib/billing/stripe-config.ts` `resolvePlanForStripePrice()` ile
   * KENDİ kataloğumuza karşı çözülen kanonik plan kodu. Fiyat kataloğa
   * çözülemediyse (ör. Stripe panelinde elle oluşturulmuş, izlenmeyen bir
   * fiyat) `null` — bu durumda `Organization.planId` ASLA değiştirilmez
   * (bkz. `reconciliationNote`).
   */
  planCode             String?
  billingInterval      BillingInterval?
  status               StripeSubscriptionStatus
  cancelAtPeriodEnd    Boolean                   @default(false)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  /** Bu abonelik tarafından EN SON grantlanan `Plan.id`. Bir "revoke" kararının GÜVENLE uygulanabilir olup olmadığını doğrulamak için kullanılır (bkz. webhook-service.ts dosya başı "revoke güvenlik koruması" notu) — organizasyonun planı bu satırın DIŞINDA (ör. yönetici tarafından elle) değiştirilmişse revoke ATLANIR. Hiç grantlanmadıysa veya en son revoke edildiyse `null`. */
  lastGrantedPlanId    String?
  /** Fiyat kataloğa çözülemediğinde vb. durumlar için sır İÇERMEYEN kısa teşhis notu — ops/destek içindir. */
  reconciliationNote   String?
  lastProcessedEventId String?
  lastProcessedEventCreatedAt DateTime?
  lastPaymentStatus    StripeInvoicePaymentStatus?
  lastPaymentAt        DateTime?
  lastInvoiceId        String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  @@unique([environment, stripeSubscriptionId])
  @@index([stripeCustomerId])
}

/**
 * RESERVED→COMMITTED (başarı) veya RESERVED→FAILED (sağlayıcı hatası) — bkz. server/services/ai-usage-reporting-service.ts.
 */
enum AiUsageStatus {
  RESERVED
  COMMITTED
  FAILED
}

/**
 * YF-711 — organizasyon başına aylık AI kota defteri (ledger). Sağlayıcı
 * çağrısından ÖNCE atomik olarak rezerve edilir (bkz.
 * server/services/ai-usage-reporting-service.ts checkQuota), yalnızca
 * BAŞARILI sağlayıcı çağrısı sonrasında kesinleşir (COMMITTED). Yalnızca
 * kullanım METAVERİSİ taşır — ham prompt/context/sır ASLA saklanmaz (bkz.
 * lib/ai/logging.ts ile aynı disiplin). Hiçbir satır hard-delete edilmez;
 * FAILED/COMMITTED satırlar kalıcı geçmiştir (bkz. mimari ilke "iptal,
 * silme değil").
 * `attemptCount` hem bayat (stale) bir rezervasyonun aynı satır üzerinde
 * denetlenebilir biçimde geri kazanılmasını (recycle) sağlar HEM DE
 * `reportUsage`'ın "fencing" (çitleme) anahtarıdır — bkz. servis dosyasındaki
 * "Row-identity guard" açıklaması: geciken bir finalize çağrısının, aynı
 * satır kimliğini yeniden kullanan bir sonraki denemeyi bozmasını önler.
 */
model AiUsageLedger {
  id                    String        @id @default(cuid())
  organizationId        String
  /**
   * UTC takvim ayı başlangıcı — bkz. lib/ai/quota-period.ts (kasıtlı olarak lib/dates.ts'in Istanbul finansal raporlama yardımcılarından bağımsız, bkz. o dosyanın başlık yorumu).
   */
  periodStart           DateTime
  idempotencyKey        String
  provider              String
  model                 String?
  status                AiUsageStatus @default(RESERVED)
  /**
   * Rezervasyon anında kaydedilen, tutucu (conservative) üst sınır — bkz. lib/ai/credits.ts estimateReservationCredits.
   */
  reservedCredits       Int
  /**
   * Müşteriye yansıyan asıl kota tüketimi — HER ZAMAN reservedCredits ile sınırlıdır (min(...)), asla aşmaz.
   */
  consumedCredits       Int           @default(0)
  /**
   * true ise gerçek kullanım rezervasyonu aşardı — tüketim rezervasyonda "capped" edildi (gözlemlenebilirlik için).
   */
  consumedCreditsCapped Boolean       @default(false)
  /**
   * Yalnızca status=RESERVED iken anlamlıdır — bu zaman geçtiğinde satır "bayat" sayılır (bkz. lib/entitlements/ai-quota-usage.ts kota toplamı bu satırları hariç tutar).
   */
  reservationExpiresAt  DateTime
  /**
   * Bayat bir rezervasyonun/başarısız denemenin aynı idempotencyKey ile geri kazanılma (recycle) sayısı; aynı zamanda reportUsage'ın fencing anahtarıdır.
   */
  attemptCount          Int           @default(1)
  lastReservationAt     DateTime      @default(now())
  /**
   * Gerçek, HİÇ sınırlanmamış (uncapped) sağlayıcı kullanımı — consumedCredits'ten bağımsız.
   */
  inputTokens           Int?
  outputTokens          Int?
  totalTokens           Int?
  /**
   * Dahili kredi-maliyet yaklaşıklaması (lib/ai/credits.ts usdPerCredit) — GERÇEK sağlayıcı faturalama maliyeti DEĞİLDİR. Her zaman gerçek (uncapped) kullanımdan hesaplanır.
   */
  estimatedCostUsd      Decimal?      @db.Decimal(12, 6)
  /**
   * Gerçek sağlayıcı faturalama maliyeti — bu fazda gerçek ücretli bir sağlayıcı olmadığından her zaman null; gelecekteki bir sağlayıcı maliyet modeli beklemede.
   */
  actualCostUsd         Decimal?      @db.Decimal(12, 6)
  failureCategory       String?
  correlationId         String
  createdById           String?
  /**
   * İlk denemenin zaman damgası — bir recycle sırasında ASLA güncellenmez (bkz. lib/audit.ts ile yazılan ai_usage.reservation_recycled audit kaydı).
   */
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, periodStart, status])
}

/**
 * YF-803 — Tenant-scoped satın alınan/ek (add-on) kota bağışı ("top-up").
 * Merkezi plan dahil kotasının (`Plan.limits`, bkz. `resolveLimitMax`) ÜZERİNE
 * eklenen, kalıcı bir "arz" (supply) kaydıdır — bir TÜKETİM (usage) kaydı
 * DEĞİLDİR (tüketim her zaman ilgili kaynağın kendi defterinde kalır: AI için
 * `AiUsageLedger`, OCR için `DocumentExtraction`, bkz. o modellerin başlık
 * yorumları). `lib/entitlements/entitlement-service.ts`
 * `resolveEffectiveLimitMax` bu tabloyu okuyup dahil kotaya ekler — "available
 * = included + add-on - consumed" formülünün "+ add-on" kısmı BURADAN gelir.
 *
 * `resource`, `lib/entitlements/capabilities.ts` `LimitId`'den biridir (DB
 * seviyesinde bir enum/FK İLE ZORLANMAZ — servis katmanı `isLimitId` ile
 * fail-closed doğrular, bkz. `grantUsageAddon`). Bu kasıtlı bir tasarımdır:
 * gelecekteki bir kaynak (SMS/WhatsApp/e-belge) yalnızca `LIMIT_IDS`'e yeni
 * bir kimlik eklemekle bu tabloyu otomatik kullanabilir — YENİ bir
 * sağlayıcıya-özgü tablo İCAT EDİLMEZ (bkz. görev talimatı "Avoid
 * overengineering provider-specific tables for hypothetical services").
 *
 * Geçerlilik `validFrom`/`validUntil` bir ARALIKTIR (tek bir takvim ayına
 * ZORUNLU DEĞİLDİR) — `validUntil: null` süresiz geçerli demektir. İptal/iade,
 * satırı SİLMEK yerine `validUntil`'i "şimdi"ye çekerek yapılır (mimari ilke
 * "hard delete yok, iptal/arşiv mantığı") — bkz. `expireUsageAddonGrant`.
 *
 * `idempotencyKey`, YF-813'ün (Stripe add-on satın alma — bu görevin kapsamı
 * DIŞINDA) bir webhook retry'ının aynı satın almayı İKİ KEZ bağışlamamasını
 * garanti eden sınırdır — `AiUsageLedger.idempotencyKey` ile AYNI desen.
 */
model UsageAddonGrant {
  id             String    @id @default(cuid())
  organizationId String
  /** `lib/entitlements/capabilities.ts` LimitId değeri — bkz. dosya başı yorumu. */
  resource       String
  /** Bağışlanan ek kota miktarı — her zaman > 0 (bkz. grantUsageAddon doğrulaması). */
  amount         Int
  /** Çağıranın ürettiği, tekrarlar arasında sabit kalan mantıksal bağış kimliği. */
  idempotencyKey String
  /** Serbest metin köken etiketi (ör. "manual", gelecekte "stripe_topup") — denetlenebilirlik için, hiçbir davranış buna göre dallanmaz. */
  source         String
  validFrom      DateTime  @default(now())
  /** null = süresiz geçerli (tüketilene/iptal edilene kadar). */
  validUntil     DateTime?
  /** Yalnızca güvenli, PII/sır İÇERMEYEN serbest meta veri (bkz. mimari ilke). */
  metadata       Json?
  /** Bağışı yapan aktör — sistem/webhook kaynaklı bağışlarda null. */
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, resource, validFrom, validUntil])
}

/**
 * YF-605-B — sağlayıcı-nötr hata sınıflandırması (bkz.
 * server/services/integrations/provider-adapter.ts). Yalnızca kategorize
 * eder; hiçbir zaman ham sağlayıcı hata gövdesi/kimlik bilgisi taşımaz.
 */
enum IntegrationErrorCategory {
  AUTH_CONFIG
  VALIDATION
  TEMPORARY_PROVIDER
  RATE_LIMIT
  TIMEOUT_NETWORK
  PERMANENT_REJECTION
  UNKNOWN
}

/**
 * RETRYING/DEAD_LETTER ayrımı yalnızca hata kategorisine göre belirlenir (bkz. provider-lifecycle-service.ts isRetryableErrorCategory).
 */
enum IntegrationOutboundOperationStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
  DEAD_LETTER
}

/**
 * YF-605-B — provider-nötr giden e-belge işlem yaşam döngüsü (bkz.
 * docs/architecture/YF-605_EINVOICE_ACCOUNTING_INTEGRATIONS.md §10). Bu fazda
 * gerçek bir sağlayıcı çağrısı yapılmaz (yalnızca sahte/no-op adaptör); bu
 * tablo mantıksal işlem kimliğini (`connectionId`+`operationType`+
 * `idempotencyKey`) ve durumunu izler — aynı mantıksal işlemin tekrar
 * çalıştırılması (unique kısıt + P2002 yakalama, `Settlement.idempotencyKey`
 * ile aynı desen) ikinci bir bağımsız kayıt OLUŞTURMAZ. `resultSummary`/
 * `errorSummary` asla ham sağlayıcı payload'ı veya kimlik bilgisi içermez.
 */
model IntegrationOutboundOperation {
  id             String                             @id @default(cuid())
  organizationId String
  connectionId   String
  operationType  String
  idempotencyKey String
  status         IntegrationOutboundOperationStatus @default(PENDING)
  attempts       Int                                @default(0)
  errorCategory  IntegrationErrorCategory?
  errorCode      String?
  errorSummary   String?
  resultSummary  String?
  createdById    String?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  @@unique([connectionId, operationType, idempotencyKey])
  @@index([organizationId, connectionId, createdAt])
  @@index([organizationId, status])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  tradeName String?
  taxOffice String?
  taxNumber String?
  phone     String?
  email     String?
  city      String?
  district  String?
  address   String?
  currency  String   @default("TRY")
  timezone  String   @default("Europe/Istanbul")
  /**
   * YF-802 — organizasyonun etkin planı. Kasıtlı olarak NULLable: bir
   * organizasyonun planı silinirse (`onDelete: SetNull`) veya hiç
   * atanmamışsa, entitlement servisi fail-closed davranır (bkz.
   * lib/entitlements/entitlement-service.ts getEffectivePlan) — asla
   * sınırsız erişime düşmez. Uygulama akışında her yeni organizasyon
   * kayıt anında bir varsayılan plana atanır (bkz.
   * server/services/organization-service.ts).
   */
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan           Plan?                  @relation(fields: [planId], references: [id], onDelete: SetNull)
  users          User[]
  invitations    Invitation[]
  projects       Project[]
  customers      Customer[]
  suppliers      Supplier[]
  categories     TransactionCategory[]
  transactions   FinancialTransaction[]
  accounts       FinancialAccount[]
  transfers      AccountTransfer[]
  auditLogs      AuditLog[]
  aiUsageLedgers AiUsageLedger[]
  usageAddonGrants UsageAddonGrant[]

  @@index([planId])
}

model User {
  id              String     @id @default(cuid())
  organizationId  String
  firstName       String
  lastName        String
  email           String
  phone           String?
  passwordHash    String?
  role            UserRole
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projectMemberships      ProjectMember[]
  auditLogs               AuditLog[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@unique([organizationId, email])
  @@index([organizationId, role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  role           UserRole
  projectIds     String[]  @default([])
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, email])
}

model Project {
  id              String        @id @default(cuid())
  organizationId  String
  customerId      String?
  code            String
  name            String
  city            String?
  district        String?
  address         String?
  startDate       DateTime?
  plannedEndDate  DateTime?
  contractAmount  Decimal       @default(0) @db.Decimal(18, 2)
  estimatedBudget Decimal       @default(0) @db.Decimal(18, 2)
  status          ProjectStatus @default(DRAFT)
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  members      ProjectMember[]
  transactions FinancialTransaction[]
  budgetItems  ProjectBudgetItem[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model ProjectMember {
  organizationId String
  projectId      String
  userId         String
  roleLabel      String?
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([organizationId, userId])
}

model Customer {
  id                  String   @id @default(cuid())
  organizationId      String
  type                String
  name                String
  identityOrTaxNumber String?
  taxOffice           String?
  contactName         String?
  phone               String?
  email               String?
  city                String?
  district            String?
  address             String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects     Project[]
  transactions FinancialTransaction[]

  @@index([organizationId, name])
}

model Supplier {
  id                  String   @id @default(cuid())
  organizationId      String
  type                String
  name                String
  identityOrTaxNumber String?
  taxOffice           String?
  contactName         String?
  phone               String?
  email               String?
  city                String?
  district            String?
  address             String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  transactions FinancialTransaction[]

  @@index([organizationId, name])
}

model TransactionCategory {
  id             String          @id @default(cuid())
  organizationId String
  type           TransactionType
  name           String
  parentId       String?
  isSystem       Boolean         @default(false)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       TransactionCategory?   @relation("CategoryTree", fields: [parentId], references: [id])
  children     TransactionCategory[]  @relation("CategoryTree")
  transactions FinancialTransaction[]
  budgetItems  ProjectBudgetItem[]

  @@unique([organizationId, type, name, parentId])
}

model FinancialTransaction {
  id                 String            @id @default(cuid())
  organizationId     String
  projectId          String?
  type               TransactionType
  customerId         String?
  supplierId         String?
  categoryId         String
  documentNumber     String?
  description        String
  issueDate          DateTime
  dueDate            DateTime?
  subtotal           Decimal           @db.Decimal(18, 2)
  taxRate            Decimal           @default(0) @db.Decimal(5, 2)
  taxAmount          Decimal           @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal           @db.Decimal(18, 2)
  currency           String            @default("TRY")
  status             TransactionStatus @default(OPEN)
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customer     Customer?           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplier     Supplier?           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  category     TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  settlements  Settlement[]

  @@index([organizationId, type, issueDate])
  @@index([organizationId, dueDate, status])
  @@index([organizationId, projectId])
}

model Settlement {
  id                 String           @id @default(cuid())
  organizationId     String
  transactionId      String
  financialAccountId String
  type               SettlementType
  amount             Decimal          @db.Decimal(18, 2)
  settlementDate     DateTime
  paymentMethod      String
  referenceNumber    String?
  notes              String?
  status             SettlementStatus @default(ACTIVE)
  createdById        String
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  idempotencyKey     String?          @unique
  createdAt          DateTime         @default(now())

  transaction      FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  financialAccount FinancialAccount     @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  movements        AccountMovement[]

  @@index([organizationId, transactionId])
  @@index([organizationId, financialAccountId, settlementDate])
}

model FinancialAccount {
  id             String               @id @default(cuid())
  organizationId String
  name           String
  type           FinancialAccountType
  bankName       String?
  iban           String?
  currency       String               @default("TRY")
  openingBalance Decimal              @default(0) @db.Decimal(18, 2)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  settlements       Settlement[]
  movements         AccountMovement[]
  outgoingTransfers AccountTransfer[] @relation("TransferFromAccount")
  incomingTransfers AccountTransfer[] @relation("TransferToAccount")

  @@unique([organizationId, name])
}

model AccountMovement {
  id                 String            @id @default(cuid())
  organizationId     String
  financialAccountId String
  type               MovementType
  direction          MovementDirection
  amount             Decimal           @db.Decimal(18, 2)
  occurredAt         DateTime
  settlementId       String?
  transferId         String?
  description        String
  createdById        String
  createdAt          DateTime          @default(now())

  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id], onDelete: Restrict)
  settlement       Settlement?      @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  transfer         AccountTransfer? @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([organizationId, financialAccountId, occurredAt])
}

model AccountTransfer {
  id                 String         @id @default(cuid())
  organizationId     String
  fromAccountId      String
  toAccountId        String
  amount             Decimal        @db.Decimal(18, 2)
  transferDate       DateTime
  description        String?
  status             TransferStatus @default(ACTIVE)
  createdById        String
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  idempotencyKey     String?        @unique
  createdAt          DateTime       @default(now())

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fromAccount  FinancialAccount  @relation("TransferFromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount    FinancialAccount  @relation("TransferToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  movements    AccountMovement[]

  @@index([organizationId, transferDate])
  @@index([organizationId, fromAccountId])
  @@index([organizationId, toAccountId])
}

model ProjectBudgetItem {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String
  categoryId     String
  plannedAmount  Decimal  @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category TransactionCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([projectId, categoryId])
}

/**
 * YF-603 — Hakediş (progress payment). `DocumentExtraction`/`BankImportBatch`
 * ile aynı ilke izlenerek projectId/customerId/categoryId/createdById/
 * approvedById/rejectedById/cancelledById/financialTransactionId kasıtlı
 * olarak Prisma `@relation` FK'i OLMADAN düz sütun olarak tutulur — mevcut
 * Project/Customer/TransactionCategory/User/FinancialTransaction
 * modellerine hiçbir dokunuş gerektirmez; tenant izolasyonu servis
 * katmanında organizationId + index ile sağlanır (bkz.
 * server/services/progress-payment-service.ts).
 * Hakediş, KENDİSİ finansal bir defter kaydı DEĞİLDİR — operasyonel bir
 * kaynak belgedir. `netAmount`, onay anında mevcut `createIncome` ile aynı
 * şekilde tek bir `FinancialTransaction` (type=INCOME) oluşturmak için
 * kullanılır ve o andan itibaren gelir/alacak gerçeği YALNIZCA o kanonik
 * kayıt ve ilişkili `Settlement`ler üzerinden okunur — gelir toplamı,
 * alacak bakiyesi ve tahsilat mantığı burada asla tekrarlanmaz.
 * `financialTransactionId` @unique olduğu için aynı hakedişe ikinci bir
 * kanonik kayıt asla bağlanamaz (DB düzeyinde çift-onay koruması); servis
 * katmanı ayrıca onay öncesi satırı `FOR UPDATE` ile kilitleyip durumu
 * yeniden okuyarak tekrarlı onay çağrılarını no-op olarak ele alır.
 * APPROVED sonrası hakediş satırı üzerinde düzenleme/iptal/silme YOKTUR;
 * ilişkili tahsilat/iptal akışları mevcut `settlement-service.ts`/
 * `transaction-service.ts cancelIncome` üzerinden yürütülür.
 */
model ProgressPayment {
  id                     String                @id @default(cuid())
  organizationId         String
  projectId              String
  customerId             String?
  categoryId             String
  sequenceNo             Int
  periodStartDate        DateTime
  periodEndDate          DateTime
  dueDate                DateTime?
  grossAmount            Decimal               @db.Decimal(18, 2)
  deductionAmount        Decimal               @default(0) @db.Decimal(18, 2)
  netAmount              Decimal               @db.Decimal(18, 2)
  notes                  String?
  status                 ProgressPaymentStatus @default(DRAFT)
  financialTransactionId String?               @unique
  submittedAt            DateTime?
  approvedAt             DateTime?
  approvedById           String?
  rejectedAt             DateTime?
  rejectedById           String?
  rejectionReason        String?
  cancelledAt            DateTime?
  cancelledById          String?
  cancellationReason     String?
  createdById            String
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  extraWorkItems ProgressPaymentExtraWorkItem[]

  @@unique([projectId, sequenceNo])
  @@index([organizationId, projectId, status])
  @@index([organizationId, status])
}

/**
 * YF-603 — Hakediş ek iş/iş değişikliği kalemi. Yalnızca bilgilendirme
 * amaçlıdır (metraj/keşif motoru DEĞİLDİR — bkz. docs/PLAN_FEATURE_MATRIX.md
 * "Hakediş metraj motoru" MVP dışı listesi); `grossAmount` alanına otomatik
 * yansımaz, kullanıcı brüt tutarı girerken bu kalemleri ayrıca dikkate alır.
 * Yalnızca üst hakediş DRAFT durumundayken eklenebilir/silinebilir (bkz.
 * server/services/progress-payment-service.ts).
 */
model ProgressPaymentExtraWorkItem {
  id                String   @id @default(cuid())
  organizationId    String
  progressPaymentId String
  description       String
  amount            Decimal  @db.Decimal(18, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  progressPayment ProgressPayment @relation(fields: [progressPaymentId], references: [id], onDelete: Cascade)

  @@index([organizationId, progressPaymentId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entityType     String
  entityId       String
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

/**
 * YF-601 — Fatura/fiş OCR taslağı. `Settlement`/`AccountMovement`/
 * `ProjectBudgetItem` ile aynı ilke izlenerek organizationId/projectId/
 * uploadedById/confirmedTransactionId kasıtlı olarak Prisma `@relation` FK'i
 * OLMADAN düz sütun olarak tutulur — bu, mevcut Organization/Project/User/
 * FinancialTransaction modellerine hiçbir dokunuş gerektirmez (Prisma yalnızca
 * `@relation` kullanılan alanlar için karşı ilişki alanı ister; tenant izolasyonu
 * zaten organizationId + index ile servis katmanında sağlanır, FK zorunlu değildir).
 * Bu KESİNLİKLE bir finansal işlem kaydı değildir — yalnızca bir taslak/aday
 * kayıttır. `confirmedTransactionId` yalnızca insan onayı sonrası, mevcut
 * `createExpense` servisi çağrıldıktan SONRA doldurulur (bkz.
 * server/services/document-extraction-service.ts). `fileData` disk yerine
 * DB'de (bytea) tutulur — henüz yapılandırılmış bir S3/nesne depolama yoktur
 * (bkz. .env.example) ve bu, rastgele dosya sistemi yolu riskini tamamen
 * ortadan kaldırır.
 */
model DocumentExtraction {
  id                     String                   @id @default(cuid())
  organizationId         String
  projectId              String?
  uploadedById           String
  fileName               String
  mimeType               String
  sizeBytes              Int
  fileData               Bytes
  status                 DocumentExtractionStatus @default(PENDING)
  providerName           String?
  candidateJson          Json?
  errorMessage           String?
  confirmedTransactionId String?                  @unique
  confirmedById          String?
  confirmedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, projectId])
}

/**
 * YF-602 — Banka ekstresi içe aktarım grubu (bir dosya yüklemesi). Tıpkı
 * `DocumentExtraction` gibi `financialAccountId`/`importedById` kasıtlı
 * olarak Prisma `@relation` FK'i OLMADAN düz sütun olarak tutulur — mevcut
 * `FinancialAccount`/`User` modellerine hiçbir dokunuş gerektirmez, tenant
 * izolasyonu servis katmanında organizationId + index ile sağlanır.
 * `fileFingerprint`, normalize edilmiş (BOM/boşluk temizlenmiş) dosya
 * baytlarının SHA-256'sıdır; `(organizationId, financialAccountId,
 * fileFingerprint)` üzerindeki DB-zorunlu benzersizlik, AYNI dosyanın aynı
 * hesaba iki kez yüklenmesini engeller (bkz. server/services/bank-import/
 * normalize.ts). Bu yalnızca hızlı bir "bu dosyayı zaten yükledin" kısayolu
 * ve tek koruma katmanı değildir — asıl finansal çift-kayıt koruması satır
 * bazlı `BankImportRow.rowFingerprint` benzersizliğidir (aşağıda).
 */
model BankImportBatch {
  id                    String   @id @default(cuid())
  organizationId        String
  financialAccountId    String
  fileName              String
  fileFingerprint       String
  rowCount              Int
  importedRowCount      Int
  errorRowCount         Int
  duplicateSkippedCount Int
  importedById          String
  createdAt             DateTime @default(now())

  rows BankImportRow[]

  @@unique([organizationId, financialAccountId, fileFingerprint])
  @@index([organizationId, financialAccountId, createdAt])
}

/**
 * YF-602 — Normalize edilmiş, ADAY banka ekstresi satırı. Bu KESİNLİKLE bir
 * finansal işlem kaydı değildir — `AccountMovement`/`Settlement`/
 * `AccountTransfer` ile hiçbir Prisma ilişkisi yoktur (bilinçli tasarım,
 * DocumentExtraction ile aynı ilke). `matchedSettlementId`/`matchedTransferId`
 * yalnızca insan onayı SONRASINDA, mevcut `createSettlement`/`createTransfer`
 * servisleri çağrıldıktan sonra doldurulur (bkz.
 * server/services/bank-import-service.ts). Satırın kendisi hiçbir zaman
 * bakiye/hesap durumunu etkilemez — yalnızca eşleştirme/mutabakat için bir
 * referans taşır.
 * `rowFingerprint` bir SHA-256'dır; `(organizationId, financialAccountId,
 * rowFingerprint)` üzerinde DB-zorunlu benzersizdir. İki FARKLI hesaplama
 * yolu vardır — banka referans numarası VARSA (organizasyon, hesap, para
 * birimi, referans)'tan türeyen GÜÇLÜ/dosyalar-arası-global bir kimlik;
 * YOKSA dosya kimliğiyle (fileFingerprint) sınırlı, yalnızca AYNI dosya
 * içindeki mükerrer koruma sağlayan ZAYIF bir kimlik (tarih/tutar/yön/
 * açıklama + dosya içi karşılaşma sırası). Referanssız satırlar için
 * FARKLI dosyalardan gelen görünüşte özdeş işlemler KASITLI OLARAK
 * birbirinden ayrı satırlar olarak içe aktarılır — bkz.
 * server/services/bank-import/normalize.ts modül başı yorumu (tam tasarım
 * gerekçesi, YF-602 review düzeltmesi).
 * Tarih/tutar/yön/para birimi alanları KASITLI OLARAK nullable'dır: `ERROR`
 * durumundaki bir satır bu alanları hiç dolduramayabilir (bkz. görev
 * talimatı "malformed money must never silently become 0") — yalnızca
 * `rawRowJson` (ham, tanınan sütunların ayrıştırılmamış metin hâli) her
 * zaman doludur.
 */
model BankImportRow {
  id                  String                        @id @default(cuid())
  organizationId      String
  financialAccountId  String
  batchId             String
  rowFingerprint      String
  transactionDate     DateTime?
  valueDate           DateTime?
  amount              Decimal?                      @db.Decimal(18, 2)
  currency            String?
  direction           MovementDirection?
  description         String
  bankReference       String?
  counterparty        String?
  rawRowJson          Json
  status              BankImportRowStatus           @default(IMPORTED)
  errorMessage        String?
  reconciliationType  BankImportReconciliationType?
  matchedSettlementId String?
  matchedTransferId   String?
  ignoredById         String?
  ignoredAt           DateTime?
  confirmedById       String?
  confirmedAt         DateTime?
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt

  batch BankImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([organizationId, financialAccountId, rowFingerprint])
  @@index([organizationId, financialAccountId, status])
  @@index([organizationId, batchId])
}
